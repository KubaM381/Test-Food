<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Warenkorb | Holzmanufaktur</title>
<style>
:root{
  --bg:#f6f5f2;
  --card:#ffffff;
  --text:#1d1d1f;
  --muted:#6e6e73;
  --accent:#1f6b3a;
  --accent-hover:#154a28;
  --border:#e7e7e7;
  --danger:#c0392b;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--text);
  line-height:1.6;-webkit-font-smoothing:antialiased;
}
.container{max-width:1100px;margin:auto;padding:0 20px;}

/* ── HEADER ── */
header{
  background:rgba(246,245,242,0.94);
  border-bottom:1px solid var(--border);
}
nav{display:flex;justify-content:space-between;align-items:center;padding:16px 0;}
nav strong{font-size:18px;letter-spacing:-0.5px;cursor:pointer;}

/* ── BUTTONS ── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:14px 28px;border-radius:999px;
  background:var(--accent);color:#fff;
  text-decoration:none;border:none;
  font-weight:600;font-size:15px;cursor:pointer;
  transition:background 0.2s,transform 0.1s;
  min-height:48px;gap:8px;
}
.btn:hover{background:var(--accent-hover);}
.btn:active{transform:scale(0.97);}
.btn-outline{background:transparent;color:var(--accent);border:2px solid var(--accent);}
.btn-outline:hover{background:var(--accent);color:#fff;}

/* ── CART PAGE LAYOUT ── */
.cart-page-wrap {
  display: flex;
  justify-content: center;
  padding: 40px 20px;
  min-height: calc(100vh - 65px);
}
.cart-page-box {
  background: #fff;
  width: 100%;
  max-width: 660px;
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.m-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 22px;border-bottom:1px solid var(--border);
}
.m-head h3{margin:0;font-size:19px;font-weight:800;}
.m-body{flex:1;}
.m-foot{padding:22px;border-top:1px solid var(--border);background:#fafafa;}

/* ── CART ITEMS ── */
.cart-item{
  display:flex;align-items:center;gap:12px;
  padding:14px 22px;border-bottom:1px solid var(--border);
}
.cart-item:last-child{border-bottom:none;}
.ci-icon{
  font-size:26px;width:44px;height:44px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:#f5f5f7;border-radius:10px;
}
.ci-info{flex:1;min-width:0;}
.ci-info strong{display:block;font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ci-info span{color:var(--muted);font-size:12px;}
.ci-price{font-weight:800;color:var(--accent);font-size:15px;white-space:nowrap;min-width:58px;text-align:right;}
.qty-ctrl{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.qty-btn{
  width:30px;height:30px;border-radius:8px;border:1.5px solid var(--border);
  background:#f5f5f7;cursor:pointer;font-size:16px;font-weight:800;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.15s;flex-shrink:0;
}
.qty-btn:hover{background:#e5e5ea;}
.qty-n{font-size:15px;font-weight:700;min-width:22px;text-align:center;}
.rm-btn{
  background:none;border:none;cursor:pointer;color:#ccc;
  font-size:16px;padding:6px;transition:color 0.2s;flex-shrink:0;
  width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:6px;
}
.rm-btn:hover{color:var(--danger);background:#fff0f0;}
.cart-total-bar{
  display:flex;justify-content:space-between;align-items:center;
  padding:14px 22px;background:#f8f7f5;
  font-size:17px;font-weight:800;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
}
.cart-empty{text-align:center;padding:60px 22px;color:var(--muted);}
.cart-empty .ce-icon{font-size:52px;display:block;margin-bottom:12px;}

/* ── CHECKOUT ── */
.co-wrap{padding:22px;}
.step-bar{display:flex;align-items:center;gap:8px;margin-bottom:22px;}
.step-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:600;}
.step-item.active{color:var(--accent);}
.step-num{
  width:22px;height:22px;border-radius:50%;
  background:var(--border);color:var(--muted);
  font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;
}
.step-item.active .step-num{background:var(--accent);color:#fff;}
.step-sep{flex:1;height:1px;background:var(--border);}
.order-summary{
  background:#f9f8f6;border:1px solid var(--border);
  border-radius:12px;padding:16px;margin-bottom:22px;
}
.order-summary h4{margin:0 0 10px;font-size:12px;text-transform:uppercase;letter-spacing:0.7px;color:var(--muted);font-weight:800;}
.os-item{display:flex;justify-content:space-between;font-size:14px;padding:3px 0;}
.os-total{
  display:flex;justify-content:space-between;
  font-size:16px;font-weight:800;
  border-top:1px solid var(--border);padding-top:10px;margin-top:8px;
}
.co-divider{
  font-size:11px;font-weight:800;text-transform:uppercase;
  letter-spacing:0.8px;color:var(--muted);margin:22px 0 12px;
}
.fg{margin-bottom:14px;}
.fg2{display:grid;gap:10px;margin-bottom:14px;}
.fg2.col2{grid-template-columns:1fr 1fr;}
.fg2.col31{grid-template-columns:3fr 1fr;}
.fg2.col12{grid-template-columns:1fr 2fr;}
.co-label{font-size:13px;font-weight:700;color:var(--text);display:block;margin-bottom:5px;}
.co-input{
  width:100%;padding:12px 14px;
  border-radius:10px;border:1.5px solid var(--border);
  font-family:inherit;font-size:15px;
  background:#fafafa;transition:border-color 0.2s,background 0.2s;
  -webkit-appearance:none;
}
.co-input:focus{outline:none;border-color:var(--accent);background:#fff;}
.co-input-err{border-color:#e53e3e!important;background:#fff8f8!important;}
.req{color:#b00020;margin-left:3px;}

/* ── AGB ── */
.agb-wrap{
  border:1.5px solid var(--border);border-radius:12px;
  overflow:hidden;margin-top:20px;background:#fafaf8;
}
.agb-hd{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 16px;cursor:pointer;font-size:14px;font-weight:700;
  user-select:none;
}
.agb-hd:hover{background:#f0efe8;}
.agb-hd svg{width:18px;height:18px;transition:transform 0.25s;flex-shrink:0;color:var(--muted);}
.agb-hd.open svg{transform:rotate(180deg);}
.agb-body{
  display:none;
  max-height:160px;overflow-y:auto;
  padding:12px 16px;
  border-top:1px solid var(--border);
  font-size:12px;line-height:1.7;color:var(--muted);
  -webkit-overflow-scrolling:touch;
}
.agb-body h6{margin:10px 0 3px;font-size:12px;color:var(--text);font-weight:700;}
.agb-body p{margin:0 0 6px;}
.agb-body.open{display:block;}
.agb-check-row{
  display:flex;align-items:flex-start;gap:10px;
  padding:13px 16px;border-top:1px solid var(--border);
  cursor:pointer;
}
.agb-check-row input{
  width:18px;height:18px;flex-shrink:0;
  accent-color:var(--accent);margin-top:2px;cursor:pointer;
}
.agb-check-row span{font-size:14px;font-weight:500;}
.agb-err-msg{
  font-size:12px;color:#b00020;font-weight:600;
  padding:0 16px 12px;display:none;
}

/* ── PAYPAL BUTTON ── */
.btn-paypal{
  width:100%;padding:16px 20px;
  background:#0070BA;color:#fff;border:none;
  border-radius:12px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:10px;
  font-size:16px;font-weight:800;
  transition:background 0.2s,transform 0.1s;
  min-height:54px;
}
.btn-paypal:hover{background:#005ea6;}
.btn-paypal:active{transform:scale(0.97);}
.btn-paypal-icon{font-size:20px;}

/* ── SUCCESS ── */
.success-inner{text-align:center;padding:42px 22px;}
.success-icon{font-size:62px;display:block;margin-bottom:14px;}
.success-inner h3{margin:0 0 8px;font-size:24px;font-weight:800;}
.success-inner p{color:var(--muted);font-size:15px;margin:0 0 6px;}
.order-num-box{
  display:inline-block;background:#f0f7f2;
  border:1.5px solid #b2d8be;border-radius:10px;
  padding:10px 22px;font-size:18px;font-weight:800;
  color:var(--accent);margin:10px 0 18px;letter-spacing:1px;
}
.paypal-note{
  background:#e8f4ff;border:1.5px solid #b3d4f0;
  border-radius:10px;padding:14px 16px;
  font-size:13px;color:#0070BA;font-weight:600;
  text-align:left;line-height:1.5;
}

@media(max-width:600px){
  .fg2.col2,.fg2.col31,.fg2.col12{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<header>
<div class="container">
<nav>
  <strong onclick="window.location.href='index.html'">🪵 Holzmanufaktur</strong>
  <button class="btn btn-outline" style="min-height:36px; padding:8px 16px; font-size:13px;" onclick="window.location.href='index.html'">
    ← Zurück zum Shop
  </button>
</nav>
</div>
</header>

<div class="cart-page-wrap">
  <div class="cart-page-box" id="pageBox">
    <!-- Hier rendert JavaScript die Inhalte (Warenkorb / Kasse) rein -->
  </div>
</div>

<script>
// Warenkorb aus dem gemeinsamen localStorage laden
let cart = JSON.parse(localStorage.getItem('holz_cart') || '[]');

function saveCart() {
  localStorage.setItem('holz_cart', JSON.stringify(cart));
}

function getItem(id){return cart.find(i=>i.productId===id);}
function changeQty(pid,d){
  const it=getItem(pid);if(!it)return;
  it.qty+=d;
  if(it.qty<=0)cart=cart.filter(i=>i.productId!==pid);
  saveCart(); renderCart();
}
function removeItem(pid){
  cart=cart.filter(i=>i.productId!==pid);
  saveCart(); renderCart();
}
function total(){return cart.reduce((s,i)=>s+i.price*i.qty,0);}
function count(){return cart.reduce((s,i)=>s+i.qty,0);}
function fmt(n){return n.toFixed(2).replace('.',',');}

/* ══════════════════════════════════════════
   WARENKORB ANSICHT
══════════════════════════════════════════ */
function renderCart(){
  const box = document.getElementById('pageBox');
  const c = count();
  
  if(cart.length === 0){
    box.innerHTML=`
      <div class="m-head"><h3>🛒 Warenkorb</h3></div>
      <div class="m-body">
        <div class="cart-empty">
          <span class="ce-icon">🛒</span>
          <p style="margin:0 0 6px;font-size:18px;font-weight:700;">Ihr Warenkorb ist leer</p>
          <p style="margin:0;font-size:14px;">Finden Sie handgefertigte Unikate in unserem Shop.</p>
        </div>
      </div>
      <div class="m-foot">
        <button class="btn btn-outline" onclick="window.location.href='index.html'" style="width:100%;border-radius:12px;">Zurück zum Shop</button>
      </div>`;
    return;
  }

  box.innerHTML=`
    <div class="m-head"><h3>🛒 Warenkorb (${c} Artikel)</h3></div>
    <div class="m-body">
      ${cart.map(it=>`
        <div class="cart-item">
          <div class="ci-icon">${it.icon}</div>
          <div class="ci-info">
            <strong>${it.name}</strong>
            <span>${fmt(it.price)} € / Stück</span>
          </div>
          <div class="qty-ctrl">
            <button class="qty-btn" onclick="changeQty('${it.productId}',-1)">−</button>
            <span class="qty-n">${it.qty}</span>
            <button class="qty-btn" onclick="changeQty('${it.productId}',1)">+</button>
          </div>
          <div class="ci-price">${fmt(it.price*it.qty)} €</div>
          <button class="rm-btn" onclick="removeItem('${it.productId}')" title="Entfernen">✕</button>
        </div>
      `).join('')}
      <div class="cart-total-bar">
        <span>Gesamt inkl. MwSt.</span>
        <span style="color:var(--accent);">${fmt(total())} €</span>
      </div>
    </div>
    <div class="m-foot">
      <div style="display:flex;flex-direction:column;gap:10px;">
        <button class="btn" onclick="renderCheckout()" style="width:100%;border-radius:12px;font-size:16px;">Zur Kasse →</button>
      </div>
      <p style="font-size:11px;color:var(--muted);margin:10px 0 0;text-align:center;">🔒 Sicherer Checkout via PayPal</p>
    </div>`;
}

/* ══════════════════════════════════════════
   CHECKOUT ANSICHT
══════════════════════════════════════════ */
function toggleAGB(){
  const body=document.getElementById('agbBody');
  const hd=document.getElementById('agbHd');
  body.classList.toggle('open');
  hd.classList.toggle('open');
}

function renderCheckout(){
  const box = document.getElementById('pageBox');
  
  box.innerHTML=`
    <div class="m-head"><h3>🔒 Bestellung abschließen</h3></div>
    <div class="m-body">
      <div class="co-wrap">
        <div class="step-bar">
          <div class="step-item active"><span class="step-num">1</span>Adresse</div>
          <div class="step-sep"></div>
          <div class="step-item active"><span class="step-num">2</span>AGB</div>
          <div class="step-sep"></div>
          <div class="step-item"><span class="step-num">3</span>PayPal</div>
        </div>

        <div class="order-summary">
          <h4>Ihre Bestellung</h4>
          ${cart.map(i=>`<div class="os-item"><span>${i.name} × ${i.qty}</span><span>${fmt(i.price*i.qty)} €</span></div>`).join('')}
          <div class="os-total"><span>Gesamtbetrag</span><span style="color:var(--accent);">${fmt(total())} €</span></div>
        </div>

        <div class="co-divider">Lieferadresse</div>
        
        <div class="fg2 col2">
          <div class="fg"><label class="co-label">Vorname <span class="req">*</span></label><input class="co-input" type="text" id="co-first" placeholder="Max"></div>
          <div class="fg"><label class="co-label">Nachname <span class="req">*</span></label><input class="co-input" type="text" id="co-last" placeholder="Mustermann"></div>
        </div>
        <div class="fg"><label class="co-label">E-Mail <span class="req">*</span></label><input class="co-input" type="email" id="co-email" placeholder="max@muster.de"></div>
        <div class="fg"><label class="co-label">Telefon <span class="req">*</span></label><input class="co-input" type="tel" id="co-phone" placeholder="+49 123 456789"></div>
        <div class="fg2 col31">
          <div class="fg"><label class="co-label">Straße <span class="req">*</span></label><input class="co-input" type="text" id="co-street" placeholder="Musterstraße"></div>
          <div class="fg"><label class="co-label">Nr. <span class="req">*</span></label><input class="co-input" type="text" id="co-hnr" placeholder="1a"></div>
        </div>
        <div class="fg2 col12">
          <div class="fg"><label class="co-label">PLZ <span class="req">*</span></label><input class="co-input" type="text" id="co-plz" placeholder="12345"></div>
          <div class="fg"><label class="co-label">Ort <span class="req">*</span></label><input class="co-input" type="text" id="co-city" placeholder="Berlin"></div>
        </div>
        <div class="fg"><label class="co-label">Anmerkung (optional)</label><textarea class="co-input" id="co-note" rows="2" placeholder="Lieferwünsche, Hinweise..."></textarea></div>

        <div class="agb-wrap">
          <div class="agb-hd" id="agbHd" onclick="toggleAGB()">
            <span>📄 Allgemeine Geschäftsbedingungen lesen</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </div>
          <div class="agb-body" id="agbBody">
            <h6>§1 Geltungsbereich</h6><p>Diese AGB gelten für alle Bestellungen...</p>
            <h6>§2 Vertragsschluss</h6><p>Nach Eingang der Bestellung...</p>
            <h6>§3 Preise & Zahlung</h6><p>Zahlung erfolgt via PayPal an kubamyszka381@gmail.com.</p>
          </div>
          <label class="agb-check-row">
            <input type="checkbox" id="agbCheck">
            <span>Ich habe die AGB gelesen und akzeptiere diese. <strong class="req">*</strong></span>
          </label>
          <p class="agb-err-msg" id="agbErr">Bitte akzeptieren Sie die AGB.</p>
        </div>
      </div>
    </div>
    <div class="m-foot">
      <button class="btn-paypal" onclick="submitOrder()">
        <span class="btn-paypal-icon">💳</span>
        Jetzt mit PayPal zahlen &nbsp;·&nbsp; ${fmt(total())} €
      </button>
      <button class="btn btn-outline" onclick="renderCart()" style="width:100%;border-radius:12px;margin-top:10px;font-size:14px;">← Zurück zum Warenkorb</button>
    </div>`;
}

/* ══════════════════════════════════════════
   BESTELLUNG ABSCHICKEN
══════════════════════════════════════════ */
function submitOrder(){
  const required=[
    {id:'co-first',name:'Vorname'}, {id:'co-last',name:'Nachname'},
    {id:'co-email',name:'E-Mail'}, {id:'co-phone',name:'Telefon'},
    {id:'co-street',name:'Straße'}, {id:'co-hnr',name:'Hausnummer'},
    {id:'co-plz',name:'PLZ'}, {id:'co-city',name:'Ort'},
  ];
  for(const f of required){
    const el=document.getElementById(f.id);
    if(!el||!el.value.trim()){
      el&&el.classList.add('co-input-err');
      el&&el.focus();
      alert(`Bitte füllen Sie das Feld "${f.name}" aus.`);
      return;
    }
    el.classList.remove('co-input-err');
  }

  const agbCheck=document.getElementById('agbCheck');
  if(!agbCheck.checked){
    const agbErr=document.getElementById('agbErr');
    agbErr.style.display='block';
    agbCheck.closest('.agb-check-row').scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }

  const letters='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const orderNum='ORD-'+letters.charAt(Math.floor(Math.random()*26))+Math.floor(100000+Math.random()*900000);

  const orderData={
    id:orderNum,type:'order',
    status:'In Bearbeitung',notes:[],
    date:new Date().toLocaleString('de-DE'),
    customer:{
      firstName:document.getElementById('co-first').value.trim(),
      lastName:document.getElementById('co-last').value.trim(),
      email:document.getElementById('co-email').value.trim(),
      phone:document.getElementById('co-phone').value.trim(),
      address:{
        street:document.getElementById('co-street').value.trim(),
        houseNumber:document.getElementById('co-hnr').value.trim(),
        zip:document.getElementById('co-plz').value.trim(),
        city:document.getElementById('co-city').value.trim(),
      }
    },
    items:cart.map(i=>({productId:i.productId,name:i.name,qty:i.qty,pricePerUnit:i.price,total:i.price*i.qty})),
    totalAmount:total(),
    paymentMethod:'PayPal',
    note:document.getElementById('co-note').value,
  };

  // Im CRM speichern
  let existing=JSON.parse(localStorage.getItem('holz_crm_data')||'[]');
  existing.push(orderData);
  localStorage.setItem('holz_crm_data',JSON.stringify(existing));

  // PayPal aufrufen
  const amount=total().toFixed(2);
  const desc=encodeURIComponent('Holzmanufaktur Bestellung '+orderNum);
  const paypalUrl=`https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=${encodeURIComponent('kubamyszka381@gmail.com')}&item_name=${desc}&amount=${amount}&currency_code=EUR&no_shipping=1`;
  window.open(paypalUrl,'_blank');

  // Warenkorb leeren
  cart=[];
  saveCart();
  
  // Erfolgsmeldung anzeigen
  const box = document.getElementById('pageBox');
  box.innerHTML=`
    <div class="m-body">
      <div class="success-inner">
        <span class="success-icon">✅</span>
        <h3>Bestellung eingegangen!</h3>
        <p>Ihre Bestellung wurde erfolgreich aufgegeben.</p>
        <div class="order-num-box">${orderNum}</div>
        <div class="paypal-note">
          💳 <strong>Bitte schließen Sie die PayPal-Zahlung im neuen Tab ab</strong>, damit Ihre Bestellung bearbeitet werden kann. Die Bestellnummer für Rückfragen notieren.
        </div>
      </div>
    </div>
    <div class="m-foot">
      <button class="btn" onclick="window.location.href='index.html'" style="width:100%;border-radius:12px;">Zurück zur Website</button>
    </div>`;
}

/* INIT */
renderCart();
</script>
</body>
</html>
